# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/bengift_tailor
# For MongoDB Atlas (cloud), use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/bengift_tailor

# JWT Secret (change this to a random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# SMS Configuration (Hubtel - Ghana)
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret
HUBTEL_SENDER_ID=BenGift

# Alternative: Africa's Talking
# AFRICASTALKING_API_KEY=your_api_key
# AFRICASTALKING_USERNAME=your_username

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
